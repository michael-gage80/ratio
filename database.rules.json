{
  "rules": {
    ".read": false,
    ".write": false,
    "live": {
      "$matchId": {
        "public": {
          ".read": "auth != null && data.child('players').child(auth.uid).exists()"
        }
      }
    },
    "presence": {
      "$matchId": {
        ".read": "auth != null && root.child('live').child($matchId).child('public/players').child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('live').child($matchId).child('public/players').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['online', 'lastSeen']) && newData.child('online').isBoolean() && newData.child('lastSeen').isNumber() && newData.child('lastSeen').val() <= now + 60000",
          "$other": { ".validate": "$other === 'online' || $other === 'lastSeen'" }
        }
      }
    }
  }
}
