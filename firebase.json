{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "*.local",
        "src",
        "lib/**/*.test.js",
        "lib/**/*.map"
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "singleProjectMode": true,
    "database": {
      "port": 9000
    },
    "storage": {
      "port": 9199
    },
    "auth": {
      "port": 9099
    }
  },
  "storage": {
    "rules": "storage.rules"
  },
  "database": {
    "rules": "database.rules.json"
  }
}
