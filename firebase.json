{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
      "ignore": ["node_modules", ".git", "*.local", "src", "lib/**/*.test.js", "lib/**/*.map"]
    }
  ],
  "emulators": {
    "firestore": { "port": 8080 },
    "singleProjectMode": true
  }
}
