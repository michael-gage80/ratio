rules_version = '2';

// Deny by default: only paths matched below are reachable. A student reads and
// writes only their own documents; scores, ratings, boards and match results are
// written only by Cloud Functions (PRD: "Security rules"), and get their own rules in
// the phases that introduce them.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Duel matches — created and refereed only by Functions; each player can read their own.
    match /matches/{matchId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.players;
    }

    // Duel ratings per student and module — written only by Functions. Readable by any
    // signed-in student (they appear on boards and versus screens).
    match /ratings/{ratingId} {
      allow read: if request.auth != null;
    }

    // The news centre and the Sunday quiz — written by the ingest Function and the admin
    // script; readable by any signed-in student.
    match /news/{storyId} {
      allow read: if request.auth != null;
    }
    match /quizzes/{sunday} {
      allow read: if request.auth != null;
    }

    // Boards — written only when Functions settle a human match; any signed-in student
    // can read them (PRD: "Boards ... written only by Functions").
    match /boards/{period}/entries/{uid} {
      allow read: if request.auth != null;
    }

    // Friend lobbies — created and changed only by Functions; members can read them and
    // their chat, which Functions filter before writing (PRD: "Friend lobby").
    match /lobbies/{code} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/lobbies/$(code)).data.members;
      }
    }

    // Async challenges — Functions only; the questions and answers live in
    // challengeSecrets, which no client can read.
    match /challenges/{challengeId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.players;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // Created on first sign-in with nothing but a server timestamp.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;

      // Onboarding fills the profile in one step at a time.
      allow update: if isOwner(uid) && isValidProfileUpdate();

      // Only an account that never passed the age gate — an under-18 leaving — can be
      // removed from the app. Full account deletion will run through a Function.
      allow delete: if isOwner(uid) && !('birthYear' in resource.data);

      // θ/σ per skill for each topic — written only by Functions (PRD: "Clients never
      // write their own scores").
      match /skills/{topicId} {
        allow read: if isOwner(uid);
      }

      // Each item's spaced-review schedule (FSRS) and each test attempt — written only
      // by the submitTest Function.
      match /items/{itemId} {
        allow read: if isOwner(uid);
      }
      match /testAttempts/{attemptId} {
        allow read: if isOwner(uid);
      }

      // The daily brief — built only by Functions (nightly, or on demand for day 1).
      match /briefs/{date} {
        allow read: if isOwner(uid);
      }

      // The days the student was active, for the weekly streak target. A marker per UK
      // date and nothing else.
      match /activity/{date} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && isAroundNow(date)
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
      }

      // Students this student has duelled — the Friends board. Written by Functions.
      match /friends/{otherUid} {
        allow read: if isOwner(uid);
      }

      // Students this student has blocked — written by the blockUser Function.
      match /blocked/{otherUid} {
        allow read: if isOwner(uid);
      }

      // How far through each lecture the student is.
      match /lessons/{lessonId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && lessonId.matches('^[a-z]+-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['partsCompleted', 'updatedAt'])
          && request.resource.data.partsCompleted is int
          && request.resource.data.partsCompleted >= 0
          && request.resource.data.partsCompleted <= 10
          && request.resource.data.updatedAt == request.time;
      }
    }

    // "Spotted an error? Report it" — create-only, for the student's own reports; triage
    // happens server-side (PRD: "Error reports: triaged within 72 hours").
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'itemId', 'reason', 'status', 'createdAt', 'appVersion'])
        && request.resource.data.keys().hasOnly(['uid', 'itemId', 'lessonId', 'reason', 'note', 'status', 'createdAt', 'appVersion'])
        && request.resource.data.itemId is string && request.resource.data.itemId.matches('^[a-z0-9-]{1,80}$')
        && (!('lessonId' in request.resource.data) || request.resource.data.lessonId.matches('^[a-z]+-[0-9]{2}$'))
        && request.resource.data.reason in ['wrong-answer', 'law-wrong', 'unclear', 'other']
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && request.resource.data.status == 'open'
        && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 20
        && request.resource.data.createdAt == request.time;
    }

    // A UK date (yyyy-mm-dd) that could be today somewhere near the server's clock, so
    // active days can't be backdated. Loose by a day either side for time zones.
    function isAroundNow(date) {
      let day = timestamp.date(int(date[0:4]), int(date[5:7]), int(date[8:10]));
      return request.time > day - duration.value(1, 'd') && request.time < day + duration.value(2, 'd');
    }

    function isValidProfileUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly(['birthYear', 'ageConfirmedAt', 'displayName', 'initial', 'programme', 'waitlist',
                              'universityId', 'universityOther', 'year', 'modules'])
        // The age gate comes first and is final: nothing else is accepted until it's
        // passed, and the birth year can't be changed afterwards.
        && ((!('birthYear' in before) && passesAgeGate(after, changed))
            || (('birthYear' in before) && !changed.hasAny(['birthYear', 'ageConfirmedAt'])))
        && (!changed.hasAny(['displayName'])
            || (after.displayName is string && after.displayName.size() >= 1 && after.displayName.size() <= 40))
        && (!changed.hasAny(['initial'])
            || !('initial' in after)
            || (after.initial is string && after.initial.matches('^\\p{Lu}$')))
        && (!changed.hasAny(['programme']) || after.programme == 'llb')
        && (!changed.hasAny(['waitlist'])
            || (after.waitlist is list && after.waitlist.hasOnly(['gdl', 'sqe', 'bptc'])))
        // A listed university (an ID from the Remote Config list) or free text for an
        // unlisted one — never both.
        && !('universityId' in after && 'universityOther' in after)
        && (!changed.hasAny(['universityId'])
            || !('universityId' in after)
            || (after.universityId is string && after.universityId.matches('^[a-z0-9-]{2,60}$')))
        && (!changed.hasAny(['universityOther'])
            || !('universityOther' in after)
            || (after.universityOther is string && after.universityOther.size() >= 2 && after.universityOther.size() <= 80))
        && (!changed.hasAny(['year']) || after.year in [1, 2, 3])
        && (!changed.hasAny(['modules'])
            || (after.modules is list && after.modules.size() >= 1
                && after.modules.hasOnly(['crime', 'contract', 'tort', 'public', 'land', 'equity', 'companylaw', 'eulaw', 'humanrights', 'jurisprudence', 'employmentlaw', 'familylaw'])));
    }

    // Only the birth year is stored (not the full date), with the server time of the
    // declaration. The exact 18th-birthday check happens in the app.
    function passesAgeGate(after, changed) {
      return changed.hasOnly(['birthYear', 'ageConfirmedAt'])
        && changed.hasAll(['birthYear', 'ageConfirmedAt'])
        && after.birthYear is int
        && after.birthYear >= request.time.year() - 100
        && after.birthYear <= request.time.year() - 18
        && after.ageConfirmedAt == request.time;
    }
  }
}
