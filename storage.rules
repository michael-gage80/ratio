rules_version = '2';

// Deny by default. Content bundles are readable by any signed-in student and written
// only by the publishing job (Admin SDK, which bypasses these rules).
service firebase.storage {
  match /b/{bucket}/o {
    match /content/{path=**} {
      allow read: if request.auth != null;
    }

    // Profile photos. The app uploads to upload.jpg; the moderateAvatar Function checks
    // it and moves it to avatar.jpg, which any signed-in student can see. Only the
    // owner can upload, and only a small JPEG.
    match /avatars/{uid}/upload.jpg {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 1024 * 1024;
    }
    match /avatars/{uid}/avatar.jpg {
      allow read: if request.auth != null;
    }

    // Apple Pencil notes on lecture parts (PencilKit drawings). Private: only their
    // owner can read or write them.
    match /notes/{uid}/{lessonId}/{file} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && file.matches('^[0-9]{1,2}[.]drawing$')
        && request.resource.contentType == 'application/octet-stream'
        && request.resource.size < 2 * 1024 * 1024;
    }
  }
}
